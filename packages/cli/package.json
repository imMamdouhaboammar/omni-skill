{
  "name": "@mamdouh-aboammar/omni-skill",
  "version": "6.2.0",
  "description": "Universal Cross-Host Agent Skill Engine & Compiler. Build once, validate across 7 strict gates, and distribute to every agent.",
  "bin": {
    "omni-skill": "./dist/index.js"
  },
  "main": "./dist/lib.js",
  "module": "./dist/lib.js",
  "types": "./dist/lib.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js",
      "default": "./dist/lib.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/lib.js",
    "dist/lib.d.ts",
    "dist/commands",
    "dist/core",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "build": "bun build ./src/index.ts ./src/lib.ts --outdir ./dist --target node && bunx tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "test": "bun test",
    "lint": "bunx tsc --noEmit"
  },
  "author": "Mamdouh Aboammar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imMamdouhaboammar/omni-skill.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/imMamdouhaboammar/omni-skill",
  "bugs": {
    "url": "https://github.com/imMamdouhaboammar/omni-skill/issues"
  },
  "keywords": [
    "omni-skill",
    "agent-skills",
    "claude-code",
    "cursor",
    "codex",
    "chatgpt",
    "antigravity",
    "poteto-mode",
    "ai-agent",
    "cli"
  ],
  "dependencies": {
    "commander": "^12.1.0",
    "fflate": "0.8.2",
    "picocolors": "^1.0.1",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "bun-types": "latest",
    "typescript": "^5.5.4"
  }
}
