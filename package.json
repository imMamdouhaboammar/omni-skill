{
  "name": "omni-skill-workspace",
  "version": "6.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "omni-skill": "./packages/cli/dist/index.js"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter \"*\" build",
    "test": "bun test && python3 packages/core/test_engine.py",
    "lint": "bun run --filter \"*\" lint",
    "cli": "bun run packages/cli/src/index.ts",
    "validate:all": "bun run packages/cli/src/index.ts validate skills/* && for s in skills/*; do python3 packages/core/portability_validator.py \"$s\" > /dev/null || exit 1; done"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.4"
  }
}
